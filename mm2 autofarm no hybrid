-- MM2 Candy V15 - V6-style direct glide / ordinary weapon input
-- Stop V6/V10 and other old loops; respawn once before first use.
-- F6 deliberately toggles farming while Roblox is focused. No F8 unload binding.
-- Candy movement does not need window focus. Recoverable errors retry automatically.
-- Murderer approach works in the background. Weapon/reset input requires focus.
-- No combat/role remote calls. Hybrid-off compatibility needs a live test.
-- Matches V6's straight XYZ interpolation, with no below-coin offset.

local CFG = {
    Username = "oneovernull",
    Limit = 50,
    Speed = 20,              -- Same normal travel speed as the supplied V6.
    FirstSpeed = 999,         -- Same fast initial approach as V6.
    MoveTick = 0.03,
    PickupHold = 0.35,
    MaxTargetDistance = 250,
    MoveStallSeconds = 1.5,
    Tick = 0.05,
    CoinTimeout = 12,
    CoinCooldown = 8,
    FinishTimeout = 90,       -- Time to approach multiple players.
    TargetTimeout = 18,
    KnifeRange = 3.5,
    GunRange = 3.75,
    CombatStand = 3,
    KnifeStand = 2.5,
    RetryDelay = 2,
    KnifeDelay = 0.85,
    GunDelay = 3,
    EquipDelay = 0.8,
    AllowReset = true,
}

local function read(fn)
    local ok, value = pcall(fn)
    if ok then return value end
end
local function log(s) print("[V15] " .. tostring(s)) end
local function child(p, name)
    return p and read(function() return p:FindFirstChild(name) end)
end
local function children(p)
    return (p and read(function() return p:GetChildren() end)) or {}
end
local function attr(p, name)
    return p and read(function() return p:GetAttribute(name) end)
end
local function finite(n)
    return type(n) == "number" and n == n and math.abs(n) < 10000000
end
local function xyz(p)
    local v = p and read(function() return p.Position end)
    if v and finite(v.X) and finite(v.Y) and finite(v.Z) then
        return {x=v.X, y=v.Y, z=v.Z}
    end
end
local function vec(p) return Vector3.new(p.x, p.y, p.z) end
local function dist(a,b)
    return math.sqrt((a.x-b.x)^2 + (a.y-b.y)^2 + (a.z-b.z)^2)
end
local function flat(a,b)
    return math.sqrt((a.x-b.x)^2 + (a.z-b.z)^2)
end
local function key(obj)
    return tostring(read(function() return obj.Address end) or obj)
end

