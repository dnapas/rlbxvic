    running=true, enabled=true, finish=true, phase="WAIT ROUND",
    active=false, round=0, charKey=nil, mapKey=nil, paused=false,
    bag=nil, raw="?", bagSource="missing", seenBelowLimit=false, full=false,
    coins={}, cooldown={}, attempts=0, collectedSignals=0, bagGain=0,
    target=nil, targetAt=0, nextBag=0, nextCoins=0, nextPlayers=0,
    nextStatus=0, nextWalk=0, nextAim=0, nextAttack=0, nextEquip=0,
    nextSafety=0, nextNav=0, nextLog={}, keys={}, roster={},
    flight=nil, collisions={}, first=true, moveWrites=0, moved=0,
    moveMode="Position", lastMoveError="none", landing=nil, nav=nil,
    finishAt=nil, finishElapsed=0, victims={}, eliminated=0, clicks=0,
    resetState=nil, resetAt=0, resetKey=nil,
    retryAt=0, retryCount=0, f6Armed=false, combatSpot=nil,
    uiBlock="none", aimPoint=nil, stableAt=nil,
    murderSpot=nil, murderRevision=0, murderSide=0,
