pcall(function() _G.MM2_CANDY_V15 = S end)
local function notice(tag,msg,delay)
    if tick() >= (S.nextLog[tag] or 0) then
        S.nextLog[tag] = tick() + (delay or 6)
        log(msg)
    end
end
local function selfParts()
    local c = read(function() return player.Character end)
    local r = child(c,"HumanoidRootPart")
    local h = c and read(function() return c:FindFirstChildOfClass("Humanoid") end)
    return c,r,h
end
local function focused()
    -- Fail closed: never send mouse/key input to an unverified foreground app.
    return read(function() return isrbxactive() end) == true
end
local function zeroVelocity(r)
    local ok=pcall(function() r.AssemblyLinearVelocity=Vector3.new(0,0,0) end)
    if not ok then ok=pcall(function() r.Velocity=Vector3.new(0,0,0) end) end
    return ok
end
local function writePosition(r,p)
    local ok,err
    if S.moveMode=="Position" then
        ok,err=pcall(function() r.Position=vec(p) end)
        if not ok then S.moveMode="CFrame" end
    end
    if S.moveMode=="CFrame" then
        ok,err=pcall(function() r.CFrame=CFrame.new(p.x,p.y,p.z) end)
    end
    if not ok then S.lastMoveError=tostring(err) end
    return ok
end
local function restoreCollisions()
    for _,entry in pairs(S.collisions) do
        pcall(function() entry.part.CanCollide=entry.value end)
    end
    S.collisions={}
end
local function releaseMovement(returnToStart)
    local f=S.flight
    S.flight=nil -- Invalidate the worker before restoring any physics settings.
    if f and returnToStart then
        local c,r=selfParts()
        local timer=child(workspace,"RoundTimerPart")
        local left=attr(timer,"Time")
        local sameMap=false
        for _,m in ipairs(children(workspace)) do
            if key(m)==f.map then sameMap=true; break end
        end
        if c and r and key(c)==f.char and sameMap and attr(player,"Alive")==true
            and type(left)=="number" and left>0 then
            -- The initial point was captured before this session disabled collisions.
            -- Return there on manual stop/error rather than solidifying inside a wall.
            writePosition(r,f.returnPoint)
            zeroVelocity(r)
        end
    end
    restoreCollisions()
end
local function stopGlide()
    local f=S.flight
    if f then
        -- Preserve the commanded point. Sampling the falling actual position
        -- on every combat tick ratcheted V12's hold downward through the floor.
        f.segment=nil
        f.hold=f.lastCommand or f.hold
        f.intent="hold"
        f.commandDistance=0
        f.checkPos=xyz(f.root) or f.hold
        f.nextCheck=tick()+CFG.MoveStallSeconds
    end
end
local function refreshNoclip(c)
    local parts=read(function() return c:GetDescendants() end) or children(c)
    for _,part in ipairs(parts) do
        local isPart=read(function() return part:IsA("BasePart") end)
        if isPart or part.ClassName=="Part" or part.ClassName=="MeshPart" then
            local id=key(part)
            if not S.collisions[id] then
                local old=read(function() return part.CanCollide end)
                if type(old)=="boolean" then S.collisions[id]={part=part,value=old} end
            end
            if S.collisions[id] then
                local ok,err=pcall(function() part.CanCollide=false end)
                if not ok then assert(false,"Cannot enable temporary noclip: "..tostring(err)) end
            end
        end
    end
end
local function motionFailure(message)
    -- Preserve the user's enabled preference; release bad movement and retry.
    S.phase="RECOVER"
    S.lastMoveError=message
    S.retryCount=S.retryCount+1
    S.retryAt=tick()+math.min(15,CFG.RetryDelay*S.retryCount)
    releaseMovement(true)
    if S.target and S.target.id then S.cooldown[S.target.id]=S.retryAt+3 end
    S.target=nil; S.combatSpot=nil; S.stableAt=nil; S.aimPoint=nil; S.murderSpot=nil
    log(message.." Auto-retry in "..math.ceil(S.retryAt-tick()).."s; farm remains enabled.")
end
local function startGlide(goal,id,rate)
    local c,r=selfParts()
    local p=xyz(r)
    if not c or not p or tick()<S.retryAt then return false end
    if not S.flight then
        local f={root=r,char=key(c),map=S.mapKey,returnPoint=p,hold=p,
            nextClip=0,nextCheck=tick()+CFG.MoveStallSeconds,checkPos=p,
            checkGoal=goal,commandDistance=0,arrived=false}
        S.flight=f
        refreshNoclip(c)
        f.nextClip=tick()+0.4
    end
    local f=S.flight
    if f.char~=key(c) then return false end
    if f.segment and f.segment.id==id and dist(f.segment.goal,goal)<1 then return true end
    if not f.segment and f.goalID==id and dist(f.hold,goal)<0.2 then return true end
    f.segment={from=p,goal=goal,at=tick(),duration=dist(p,goal)/math.max(rate,1),id=id}
    f.goalID=id; f.arrived=false; f.intent="travel"
    return true
end
local function movementTick()
    local f=S.flight
    if not f then return end
    local c,r=selfParts()
    local timer=child(workspace,"RoundTimerPart")
    local left=attr(timer,"Time")
    if not S.running or not S.enabled or not c or not r or key(c)~=f.char
        or attr(player,"Alive")~=true or type(left)~="number" or left<=0 then
        releaseMovement(false)
        return
    end
    if tick()>=f.nextClip then
        f.nextClip=tick()+0.4
        refreshNoclip(c)
    end
    local observed=xyz(r)
    if not observed then motionFailure("Root position unreadable."); return end
    local desired=f.hold
    local segment=f.segment
    if segment then
        local alpha=math.min((tick()-segment.at)/math.max(segment.duration,0.001),1)
        local a,b=segment.from,segment.goal
        desired={x=a.x+(b.x-a.x)*alpha,y=a.y+(b.y-a.y)*alpha,z=a.z+(b.z-a.z)*alpha}
        if alpha>=1 then
            f.segment=nil; f.arrived=true; f.arrivedAt=tick()
        end
    end
    -- Only diagnose stalled TRAVEL. Holding still is intentional at full bag,
    -- while equipping, and while waiting for focus/UI.
    if f.intent=="travel" and not f.segment and dist(observed,desired)<0.5 then
        f.intent="hold"
        f.commandDistance=0
    end
    if f.intent=="travel" then
        f.commandDistance=math.max(f.commandDistance,dist(f.checkPos,desired))
    else f.commandDistance=0 end
    if tick()>=f.nextCheck then
        local moved=dist(observed,f.checkPos)
        S.moved=moved
        if f.intent=="travel" and f.commandDistance>2 and moved<0.25 then
            if S.moveMode=="Position" then
                S.moveMode="CFrame"
                log("Position writes produced no observed travel; trying CFrame.")
            else
                motionFailure("Both movement setters produced no observed travel; check attachment/competing scripts.")
                return
            end
        elseif f.lastCommand and dist(observed,f.lastCommand)>15 then
            f.corrections=(f.corrections or 0)+1
            if f.corrections>=2 then
                motionFailure("Repeated position corrections or falling detected; returned to glide start.")
                return
            end
        else f.corrections=0 end
        f.checkPos=observed; f.commandDistance=0
        f.nextCheck=tick()+CFG.MoveStallSeconds
    end
    if S.flight~=f then return end
    if not zeroVelocity(r) then motionFailure("Velocity writes unavailable; glide stopped."); return end
    if S.flight~=f or not S.running or not S.enabled then return end
    if not writePosition(r,desired) then motionFailure("Movement write failed: "..S.lastMoveError); return end
    f.hold=desired; f.lastCommand=desired; S.moveWrites=S.moveWrites+1
end
local function cancelReset()
    if S.resetKey then pcall(function() keyrelease(S.resetKey) end) end
    S.resetKey, S.resetState = nil,nil
end
local function clearAction()
    releaseMovement(true)
    cancelReset()
    S.target=nil; S.combatSpot=nil; S.aimPoint=nil; S.murderSpot=nil
end
function S.Stop(reason)
    if not S.running then return end
    S.running=false
    clearAction()
    log("Unloaded by explicit Stop: "..tostring(reason or "external caller"))
end

local uiReady = pcall(function()
    UI.AddTab("MM2 Candy V15", function(tab)
        local section=tab:Section("V6-style glide", "Left")
        section:Toggle("mm2_v15_farm", "Enable Autofarm")
        section:Toggle("mm2_v15_finish", "Finish Rounds at 50")
    end)
